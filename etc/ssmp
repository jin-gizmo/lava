@CliCommand.register('load')
class CmdLoad(CliCommand):
    """Load SSM parameters from a YAML file in the format produced by the "dump" command."""

    help_ = 'Load SSM parameters from a YAML file in the format produced by the "dump" command.'
    epilog_ = 'Note that tags are added to any existing tags for a parameter.'

    PARAM_SPEC_REQUIRED = {'Name', 'Value', 'Type'}
    PARAM_SPEC_RENDER = {'Name', 'Description', 'Value', 'KeyId', 'Tags'}
    PARAM_SPEC_FORBIDDEN = {'Overwrite'}
    CENSORED_SECRET = '___ censored ___'  # noqa S105

    # ---------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments for load."""

        self.argp.add_argument(
            '-d',
            '--dryrun',
            action='store_true',
            help=(
                'Verify and resolve all parameter values but don\'t write anything'
                ' to the SSM parameter store.'
            ),
        )
        self.argp.add_argument(
            '-e',
            '--env-file',
            metavar='FILE.env',
            action='store',
            help=(
                'The name of a dotenv formatted file containing variables to be'
                ' substituted using $VAR / ${VAR} substitution into the following'
                f' fields: {", ".join(sorted(self.PARAM_SPEC_RENDER))}.'
                ' If not specified, a dotenv file with the same stem as the parameter'
                ' file will be used, if present (e.g. "params.yaml" would become'
                ' "params.env"). Otherwise, the file ".env" will be searched for,'
                ' starting with the current directory and working up to the root'
                ' directory. Environment variables whose names begin with SSMP_,'
                ' or that match a -E pattern, are also used and take precedence'
                ' over values in the file.'
            ),
        )

        self.argp.add_argument(
            '-E',
            '--env-var',
            metavar='GLOB',
            action='append',
            default=[],
            help=(
                'Also make environment variables matching the specified glob pattern'
                ' available for substitution. Can be repeated. Environment variables'
                ' beginning with "SSMP_" are always available. Variables in the dotenv'
                ' file are not filtered.'
            ),
        )

        self.argp.add_argument(
            '-f',
            '--force',
            action='store_true',
            help='Update existing SSM parameters. By default, existing parameters are skipped.',
        )

        self.argp.add_argument(
            '-i',
            '--input',
            metavar='FILE.yaml',
            action='store',
            required=True,
            help=(
                'The name of an input YAML file for the parameters. SecureString'
                ' parameters must have a value that references an environment'
                ' variable read from a dotenv file or the host environment.'
                ' If the input file name does not end with ".yaml", this will be added.'
            ),
        )

        self.argp.add_argument(
            '-p',
            '--path',
            action='store',
            help=(
                'Load parameters with relative names under the specified path,'
                ' which must start  with "/". Absolute parameter names are not'
                ' modified. This option must be specified if there are any parameters'
                ' with relative names. i.e a default path of "/" is NOT assumed.'
            ),
        )

        self.argp.add_argument(
            '--show-secrets',
            action='store_true',
            help=(
                'With --dryrun, show the resolved values of SecureString parameters'
                ' instead of censoring them. The output will contain secrets. Be careful.'
            ),
        )

    # --------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace):
        """Check the arguments."""

        if args.path:
            if not args.path.startswith('/'):
                raise ValueError('path must start with "/"')
            # Make args.path safe for '{args.path}/name' appends
            args.path = args.path.strip('/')
            if args.path:
                args.path = f'/{args.path}'

        if args.show_secrets and not args.dryrun:
            raise ValueError('--show-secrets requires --dryrun')

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """Load SSM parameters."""

        if not args.input.endswith('.yaml'):
            args.input += '.yaml'
        input_path = Path(args.input)
        ssm_params = self.read_ssm_params_file(input_path)

        # Variables available for substitution: everything in the dotenv file, plus
        # only those real environment variables that are explicitly allowed. This
        # stops a shared parameters file from harvesting unrelated secrets (e.g.
        # AWS credentials) from the environment into SSM parameter fields.
        env_path = self.find_env_file(args.env_file, input_path)
        file_vars = dotenv_values(env_path, interpolate=False) if env_path else {}
        blessed_vars = {*ENV_ALLOWED_PATTERNS, *args.env_var}
        env_vars = {
            **file_vars,
            **{k: v for k, v in os.environ.items() if any(fnmatchcase(k, p) for p in blessed_vars)},
        }

        # ------------------------------
        # Phase 1: Render and validate everything. Nothing is written to SSM.
        n_errors = 0
        for n, ssm_param_spec in enumerate(ssm_params, 1):
            ssm_param_id = ssm_param_spec.get('Name', f'Parameter {n}')
            try:
                self.validate_ssm_param_spec(ssm_param_spec)
            except Exception as e:
                print(f'{H1}{ssm_param_id}{RESET}: {e}')
                n_errors += 1
                continue

            for attr in set(ssm_param_spec) & self.PARAM_SPEC_RENDER:
                try:
                    ssm_param_spec[attr] = self.render_value(ssm_param_spec[attr], env_vars)
                except KeyError as e:
                    print(f'{H1}{ssm_param_id}{RESET}: {attr}: Cannot find value for {e}')
                    n_errors += 1
                    break
                except Exception as e:
                    # Bad placeholder in template or some other kind of rendering issue.
                    print(f'{H1}{ssm_param_id}{RESET}: {attr}: {e}')
                    n_errors += 1
                    break
            else:
                # Relative parameter names need path to make them absolute.
                if not ssm_param_spec['Name'].startswith('/'):
                    if args.path is None:
                        print(f'{H1}{ssm_param_id}{RESET}: Relative path names require --path')
                        n_errors += 1
                    else:
                        ssm_param_spec['Name'] = f'{args.path}/{ssm_param_spec["Name"].strip("/")}'

        # Look for duplicate parameter names
        c = Counter(p['Name'] for p in ssm_params if 'Name' in p)
        duplicates = [name for name, count in c.items() if count > 1]
        if duplicates:
            print(
                f'\n{ERR}Duplicate parameter {plural("name", len(duplicates))}:'
                f' {", ".join(sorted(duplicates))}{RESET}'
            )
            n_errors += len(duplicates)

        if n_errors:
            print(f'\n{ERR}{n_errors} {plural("error", n_errors)}; no parameters loaded{RESET}')
            return 1

        if args.dryrun:
            if not args.show_secrets:
                for ssm_param_spec in ssm_params:
                    if ssm_param_spec['Type'] == 'SecureString':
                        ssm_param_spec['Value'] = self.CENSORED_SECRET
            else:
                print(f'{WARNING}# Secrets may be present below -- Be careful!{RESET}')
            yaml.dump(ssm_params, sys.stdout, default_flow_style=False, sort_keys=False)
            return 0

        # ------------------------------
        # Phase 2: Load to SSM parameter store.
        n_loaded = n_skipped = 0
        ssm = boto3.Session().client('ssm')
        for ssm_param_spec in ssm_params:
            name = ssm_param_spec['Name']
            exists = ssm_param_exists(name, ssm_client=ssm)
            if exists and not args.force:
                print(f'{H1}{name}{RESET}: Already exists')
                n_skipped += 1
                continue

            try:
                if exists:
                    # AWS prohibits Overwrite together with Tags, so tag separately.
                    tags = ssm_param_spec.pop('Tags', None)
                    ssm.put_parameter(**ssm_param_spec, Overwrite=True)
                    if tags:
                        ssm.add_tags_to_resource(
                            ResourceType='Parameter', ResourceId=name, Tags=tags
                        )
                else:
                    ssm.put_parameter(**ssm_param_spec)
                print(f'{H1}{name}{RESET}: Loaded')
                n_loaded += 1
            except (ParamValidationError, ClientError) as e:
                print(f'{H1}{name}{RESET}: Failed - {e}')
                n_errors += 1

        print()
        print(f'{INFO}{n_loaded} SSM {plural("parameter", n_loaded)} loaded{RESET}')
        print(f'{INFO}{n_skipped} SSM {plural("parameter", n_skipped)} skipped{RESET}')
        print(f'{INFO}{n_errors} SSM {plural("error", n_errors)}{RESET}')
        return 1 if n_errors else 0

    # ---------------------------------------------------------------------------
    @staticmethod
    def find_env_file(env_file: str | None, input_path: Path) -> Path | None:
        """Locate the dotenv file: -e, then <input>.env, then .env search."""

        if env_file:
            path = Path(env_file)
            if not path.is_file():
                raise FileNotFoundError(f'{path}: no such file')
            return path

        env_companion_path = input_path.with_suffix('.env')
        if env_companion_path.is_file():
            print(f'{INFO}Using variables from {env_companion_path}{RESET}', file=sys.stderr)
            return env_companion_path

        if found := find_dotenv(usecwd=True):
            print(f'Using variables from {found}', file=sys.stderr)
            return Path(found)

        # Environment variables only.
        return None

    # ---------------------------------------------------------------------------
    @staticmethod
    def read_ssm_params_file(params_file: Path) -> list[dict[str, Any]]:
        """Read the SSM parameters file."""

        with open(params_file) as fp:
            data = yaml.safe_load(fp) or {}

        if not isinstance(data, dict):
            raise Exception('SSM parameters file must be an object (dict)')

        ssm_params = data.get('Parameters', [])
        if not isinstance(ssm_params, list):
            raise Exception('Parameters must be a list')
        if not ssm_params:
            raise Exception('No SSM parameters found')

        return ssm_params

    # ---------------------------------------------------------------------------
    @classmethod
    def validate_ssm_param_spec(cls, ssm_param_spec: dict[str, Any]) -> None:
        """Validate an SSM parameter specification."""

        if missing := cls.PARAM_SPEC_REQUIRED - set(ssm_param_spec):
            raise ValueError(f'Missing {plural("key", len(missing))}: {", ".join(sorted(missing))}')

        # Spec file is not allowed to control these fields
        for key in cls.PARAM_SPEC_FORBIDDEN:
            ssm_param_spec.pop(key, None)

        if ssm_param_spec.get('Type') == 'SecureString':
            value = ssm_param_spec.get('Value')
            if not isinstance(value, str) or not SECURE_REF.fullmatch(value):
                raise ValueError(
                    'SecureString "Value" must be a single variable reference (e.g. "${{VAR}}")'
                )

    # ---------------------------------------------------------------------------
    @staticmethod
    def render_value(value: Any, render_vars: dict[str, str]) -> str:
        """
        Render a value using the specified vars.

        For non string values, we use a hack and convert them to JSON and
        render the blob. Works fine in all of the situations that matter and
        avoids handcrafting a lot of recursive descent hooey.
        """

        if isinstance(value, str):
            return Template(value).substitute(render_vars)

        rendererd = Template(json.dumps(value)).substitute(render_vars)
        return json.loads(rendererd)


# ------------------------------------------------------------------------------
@CliCommand.register('rm')
class CmdRm(CliCommand):
    """Remove SSM parameters."""

    help_ = 'Remove SSM parameters.'

    MAX_RM = 5  # Force must be used if more than this number of params would be removed.
    DELETE_BATCH = 20  # Delete in batches

    # --------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments to the command handler."""

        i_or_f = self.argp.add_mutually_exclusive_group()
        i_or_f.add_argument(
            '-d',
            '--dryrun',
            action='store_true',
            help='Do a dry run. No parameters will be removed.',
        )

        i_or_f.add_argument(
            '-f',
            '--force',
            action='store_true',
            help=(
                'Force removal of parameters. Force is required to remove more'
                f' than {self.MAX_RM} than parameters when not in'
                ' interactive (-i) mode.'
            ),
        )

        i_or_f.add_argument(
            '-i',
            '--interactive',
            action='store_true',
            help=(
                'Request confirmation before attempting to remove each parameter.'
                ' Stdin must be connected to a tty.'
            ),
        )

        self.argp.add_argument(
            '-r',
            '--recursive',
            action='store_true',
            help=(
                'Recurse into the parameter hierarchy. If specified, all target names'
                ' must be parameter paths beginning with "/".'
            ),
        )

        self.argp.add_argument(
            'name',
            nargs='+',
            help=(
                'SSM parameter to remove. If -r / --recursive is specified,'
                ' this will be treated as a path and must begin with "/".'
            ),
        )

    # ---------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace):
        """Validate arguments."""

        if args.interactive and not os.isatty(sys.stdin.fileno()):
            raise RuntimeError('Stdin must be a tty for interactive mode')

        if args.recursive:
            for p in args.name:
                if not p.startswith('/'):
                    raise ValueError(
                        f'{p}: Name must be a path starting with "/" in recursive mode'
                    )

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """Remove SSM parameters."""

        ssm = boto3.Session().client('ssm')
        parameters = {}
        if args.recursive:
            for p in args.name:
                parameters |= ssm_describe_parameters_by_path(
                    p, recursive=args.recursive, ssm_client=ssm
                )
        else:
            parameters = ssm_describe_parameters_by_name(args.name, ssm_client=ssm)

        if len(parameters) > self.MAX_RM and not any((args.dryrun, args.force, args.interactive)):
            raise RuntimeError(
                'One of dry run (-d), force (-f) or interactive (-i) mode is'
                f' required to remove more than {self.MAX_RM} parameters'
            )

        to_delete = []
        invalid = []
        for name in sorted(parameters):
            if not parameters[name]:
                invalid.append(name)
                continue
            if args.dryrun or not args.interactive or ask_yn(f'Delete {name}? '):
                to_delete.append(name)

        if args.dryrun:
            deleted = to_delete
            fmt, action_msg = INFO, 'Will delete'
        else:
            fmt, action_msg = OK, 'Deleted'
            deleted = []
            for chunk in chunk_list(to_delete, self.DELETE_BATCH):
                result = ssm.delete_parameters(Names=chunk)
                deleted.extend(result['DeletedParameters'])
                invalid.extend(result['InvalidParameters'])

        for name in sorted(deleted):
            print(f'{fmt}{name}{RESET}: {action_msg}')
        for name in sorted(invalid):
            print(f'{ERR}{name}{RESET}: Invalid')

        n_deleted = len(deleted)
        n_invalid = len(invalid)
        print()
        print(
            f'{n_deleted} {plural("parameter", n_deleted)}'
            f'{" would be" if args.dryrun else ""} deleted'
        )
        if n_invalid:
            print(f'{n_invalid} {plural("parameter", n_invalid)} invalid')

        if args.dryrun and len(parameters) > self.MAX_RM:
            print('Note: Force (-f) or interactive (-i) mode would be required')

        return 0


# ------------------------------------------------------------------------------
def process_cli_args() -> Namespace:
    """Process the command line arguments."""

    argp = ArgumentParser(prog=PROG, description='Manage path based AWS SSM parameters.')

    argp.add_argument(
        '-v',
        '--version',
        action='version',
        version=__version__,
        help='Show version and exit.',
    )

    # Add the sub-commonads
    subp = argp.add_subparsers(required=True, title='commands')
    for cmd in sorted(CliCommand.commands.values(), key=lambda c: c.name):
        cmd(subp).add_arguments()

    args = argp.parse_args()

    try:
        args.handler.check_arguments(args)
    except ValueError as e:
        argp.error(str(e))

    return args


# ------------------------------------------------------------------------------
def main() -> int:
    """Show time."""
    try:
        args = process_cli_args()
        return args.handler.execute(args)
    except Exception as ex:
        # Uncomment for debugging
        # raise  # noqa: ERA001
        print(ex, file=sys.stderr)
        return 1
    except KeyboardInterrupt:  # pragma: no cover
        print('Interrupt', file=sys.stderr)
        return 2


