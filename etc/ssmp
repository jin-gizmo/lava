@CliCommand.register('rm')
class CmdRm(CliCommand):
    """Remove SSM parameters."""

    MAX_RM = 5  # Force must be used if more than this number of params would be removed.
    DELETE_BATCH = 20  # Delete in batches

    # --------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments to the command handler."""

        i_or_f = self.argp.add_mutually_exclusive_group()
        i_or_f.add_argument(
            '-d',
            '--dryrun',
            action='store_true',
            help='Do a dry run. No parameters will be removed.',
        )

        i_or_f.add_argument(
            '-f',
            '--force',
            action='store_true',
            help=(
                'Force removal of parameters. Force is required to remove more'
                f' than {self.MAX_RM} than parameters when not in'
                ' interactive (-i) mode.'
            ),
        )

        i_or_f.add_argument(
            '-i',
            '--interactive',
            action='store_true',
            help=(
                'Request confirmation before attempting to remove each parameter.'
                ' Stdin must be connected to a tty.'
            ),
        )

        self.argp.add_argument(
            '-r',
            '--recursive',
            action='store_true',
            help=(
                'Recurse into the parameter hierarchy. If specified, all target names'
                ' must be parameter paths beginning with "/".'
            ),
        )

        self.argp.add_argument(
            'name',
            nargs='+',
            help=(
                'SSM parameter to remove. If -r / --recursive is specified,'
                ' this will be treated as a path and must begin with "/".'
            ),
        )

    # ---------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace):
        """Validate arguments."""

        if args.interactive and not isatty(sys.stdin.fileno()):
            raise RuntimeError('Stdin must be a tty for interactive mode')

        if args.recursive:
            for p in args.name:
                if not p.startswith('/'):
                    raise ValueError(
                        f'{p}: Name must be a path starting with "/" in recursive mode'
                    )

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """Remove SSM parameters."""

        ssm = boto3.Session().client('ssm')
        parameters = {}
        if args.recursive:
            for p in args.name:
                parameters |= ssm_describe_parameters_by_path(
                    p, recursive=args.recursive, ssm_client=ssm
                )
        else:
            parameters = ssm_describe_parameters_by_name(args.name, ssm_client=ssm)

        if len(parameters) > self.MAX_RM and not any((args.dryrun, args.force, args.interactive)):
            raise RuntimeError(
                'One of dry run (-d), force (-f) or interactive (-i) mode is'
                f' required to remove more than {self.MAX_RM} parameters'
            )

        to_delete = []
        invalid = []
        for name in sorted(parameters):
            if not parameters[name]:
                invalid.append(name)
                continue
            if args.dryrun or not args.interactive or ask_yn(f'Delete {name}? '):
                to_delete.append(name)

        if args.dryrun:
            deleted = to_delete
            fmt, action_msg = INFO, 'Will delete'
        else:
            fmt, action_msg = OK, 'Deleted'
            deleted = []
            for chunk in chunk_list(to_delete, self.DELETE_BATCH):
                result = ssm.delete_parameters(Names=chunk)
                deleted.extend(result['DeletedParameters'])
                invalid.extend(result['InvalidParameters'])

        for name in sorted(deleted):
            print(f'{fmt}{name}{RESET}: {action_msg}')
        for name in sorted(invalid):
            print(f'{ERR}{name}{RESET}: Invalid')

        n_deleted = len(deleted)
        n_invalid = len(invalid)
        print()
        print(
            f'{n_deleted} {plural("parameter", n_deleted)}'
            f'{" would be" if args.dryrun else ""} deleted'
        )
        if n_invalid:
            print(f'{n_invalid} {plural("parameter", n_invalid)} invalid')

        if args.dryrun and len(parameters) > self.MAX_RM:
            print('Note: Force (-f) or interactive (-i) mode would be required')

        return 0


# ------------------------------------------------------------------------------
def process_cli_args() -> Namespace:
    """Process the command line arguments."""

    argp = ArgumentParser(prog=PROG, description=__doc__)

    argp.add_argument(
        '-v',
        '--version',
        action='version',
        version=__version__,
        help='Show version and exit.',
    )

    # Add the sub-commonads
    subp = argp.add_subparsers(required=True, title='commands')
    for cmd in sorted(CliCommand.commands.values(), key=lambda c: c.name):
        cmd(subp).add_arguments()

    args = argp.parse_args()

    try:
        args.handler.check_arguments(args)
    except ValueError as e:
        argp.error(str(e))

    return args


# ------------------------------------------------------------------------------
def main() -> int:
    """Show time."""
    try:
        args = process_cli_args()
        return args.handler.execute(args)
    except Exception as ex:
        # Uncomment for debugging
        # raise  # noqa: ERA001
        print(ex, file=sys.stderr)
        return 1
    except KeyboardInterrupt:  # pragma: no cover
        print('Interrupt', file=sys.stderr)
        return 2


# ------------------------------------------------------------------------------
# This only gets used during dev/test. Once deployed as a package, main() gets
# imported and run directly.
if __name__ == '__main__':  # pragma: no cover
    exit(main())
