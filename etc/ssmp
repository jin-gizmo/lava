@CliCommand.register('ls')
class CmdList(CliCommand):
    """List SSM parameters."""

    # Transformation spec for long long list
    long_long_list_fields = {
        'ARN': get,
        'Type': get,
        'KeyId': get,
        'LastModifiedDate': get,
        'LastModifiedUser': get,
    }

    # ---------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments to the command handler."""

        self.argp.add_argument(
            '-l',
            dest='long',
            action='count',
            default=0,
            help='List parameters in long format. Can be repeated to get more information.',
        )

        self.argp.add_argument(
            '-r',
            '--recursive',
            action='store_true',
            help=(
                'Recurse into the parameter hierarchy. If not specified, only'
                ' parameters at the level of the specified path will be returned.'
            ),
        )

        self.argp.add_argument(
            'path',
            nargs='*',
            default=['/'],
            help='The hierarchy for the parameter(s). Must start with "/". Default is "/".',
        )

    # ---------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace):
        """Validate arguments."""

        for p in args.path:
            if not p.startswith('/'):
                raise ValueError(f'{p}: Path must start with "/"')

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """List SSM parameters."""

        ssm = boto3.Session().client('ssm')
        parameters = {}
        for p in args.path:
            parameters |= ssm_describe_parameters_by_path(
                p, recursive=args.recursive, ssm_client=ssm
            )
        for name in sorted(parameters):
            if not args.long:
                print(name)
                continue

            print(f'{H1}{name}{RESET}: {parameters[name].get("Description", "")}')
            if args.long > 1:
                p = transform_dict(parameters[name], self.long_long_list_fields)
                for k, v in p.items():
                    print(f'    {H2}{k}{RESET}: {v}')
        return 0


