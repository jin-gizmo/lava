@CliCommand.register('dump')
class CmdDump(CliCommand):
    """Dump SSM parameters."""

    help_ = 'Dump SSM parameters.'
    epilog_ = """
        The output of "dump" is intended as input to "load". Parameters are
        written to a YAML file. For SecureString parameters, values are written
        to a companion dotenv file with the same name but a ".env" suffix (e.g.
        "params.yaml" and "params.env") and the YAML file refers to them as
        ${SSMP_...} variables. The dotenv file contains secrets and must not be
        committed to a repo. Note that "$" characters in values will be escaped
        as "$$".
    """

    # Transformation spec to select / mutate params for output.  See
    # transform_dict() for details. ENV_VAR_KEY is set by execute() for
    # SecureStrings and is not itself output.
    dump_fields = {
        'Name': get,
        # Need to escape an $ in description.
        'Description': lambda k, d: d[k].replace('$', '$$') or None,
        'Value': lambda k, d: (
            f'${{{d[ENV_VAR_KEY]}}}'
            if d['Type'] == 'SecureString'
            else d.get(k, '').replace('$', '$$')
        ),
        'Type': get_if_not_empty,
        'KeyId': get,
        'AllowedPattern': get_if_not_empty,
        'Tier': partial(get_if_not_equal, value='Standard'),
        'Policies': ssm_policies_to_put_format,
        'DataType': partial(get_if_not_equal, value='text'),
        'Tags': ssm_tags_to_put_format,
    }

    # ---------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments to the command handler."""

        self.argp.add_argument(
            '-o',
            '--output',
            metavar='FILE.yaml',
            action='store',
            required=True,
            help=(
                'The name of an output YAML file for the parameters. If the name'
                ' does not end with ".yaml", this will be added. SecureString values'
                ' are not written to this file. If there are any, they are written'
                ' to a companion dotenv file with the same name but a ".env" suffix'
                ' (e.g. "params.yaml" -> "params.env").'
                ' Your .gitignore should contain "*.env".'
            ),
        )

        self.argp.add_argument(
            '-r',
            '--recursive',
            action='store_true',
            help=(
                'Recurse into the parameter hierarchy. If not specified, only'
                ' parameters at the level of the specified path will be returned.'
            ),
        )

        self.argp.add_argument(
            'path',
            nargs='*',
            default=['/'],
            help='The hierarchy for the parameter(s). Must start with "/". Default is "/".',
        )

    # ---------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace) -> None:
        """Validate arguments."""

        for p in args.path:
            if not p.startswith('/'):
                raise ValueError(f'{p}: Path must start with "/"')

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """Dump SSM parameters."""

        # Can't use safe_dump here because we want to override the dumper.
        dumper = partial(yaml.dump, default_flow_style=False, Dumper=YamlIndentDumper)

        ssm = boto3.Session().client('ssm')

        # ------------------------------
        # We need the value of each parameter and the KMS key ID for SecureString
        # parameters so we need to merge the results from DescribeParameters and
        # GetParametersByPath. Tags are not provided by either of these so we
        # need to get them separately.
        ssm_params = {}
        descriptions = {}
        for p in args.path:
            paginator = ssm.get_paginator('get_parameters_by_path')
            ssm_params |= {
                param['Name']: param
                for page in paginator.paginate(
                    Path=p, Recursive=args.recursive, WithDecryption=True
                )
                for param in page['Parameters']
            }

            descriptions |= ssm_describe_parameters_by_path(
                p, recursive=args.recursive, ssm_client=ssm
            )
        # Tags need a separate call per parameter - there is no bulk API.
        for name, param in ssm_params.items():
            param['Tags'] = ssm.list_tags_for_resource(ResourceType='Parameter', ResourceId=name)[
                'TagList'
            ]

        # Merge descriptions into the values.
        for k, v in ssm_params.items():
            try:
                v |= descriptions[k]
            except KeyError:
                raise RuntimeError(f'Parameter {k} has a value but no description')

        # Allocate environment variable names for the SecureStrings.
        secure = {n: p for n, p in sorted(ssm_params.items()) if p['Type'] == 'SecureString'}
        for name, var in assign_env_vars(secure).items():
            secure[name][ENV_VAR_KEY] = var

        # ------------------------------
        # Transform parameters into desired content and output
        xform_params = [
            transform_dict(param, self.dump_fields)
            for param in sorted(ssm_params.values(), key=lambda d: d['Name'])
        ]
        if not args.output.endswith('.yaml'):
            args.output += '.yaml'
        with open(args.output, 'w') as fp:
            dumper({'Parameters': xform_params}, fp, sort_keys=False)
        n = len(xform_params)
        print(f'{INFO}{n} {plural("parameter", n)} written to {args.output}{RESET}')

        # ------------------------------
        # Companion dotenv file holding the SecureString values.
        if secure:
            env_path = Path(args.output).with_suffix('.env')
            # Create / truncate with restrictive permissions before writing any secret.
            os.close(os.open(env_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600))
            os.chmod(env_path, 0o600)  # os.open's mode applies only on creation
            for param in secure.values():
                set_key(env_path, param[ENV_VAR_KEY], param['Value'], quote_mode='always')
            n = len(secure)
            print(f'{INFO}{n} secure parameter {plural("value", n)} written to {env_path}{RESET}')

        return 0


