@CliCommand.register('dump')
class CmdDump(CliCommand):
    """
    Dump SSM parameters.

    The output of "dump" is intended as input to "load". Note that "$" characters
    in values will be escaped as "$$".
    """

    # Transformation specs to select / mutate params for output.
    # See transform_dict() for details.
    # Note that SSM parameters can have Tags but neither DescribeParameters nor
    # GetParameter* will return them and it's not worth the trouble to fetch
    # them parameter by parameter.
    dump_fields = {
        'Name': get,
        'Description': get_if_not_empty,
        'Value': lambda k, d: (
            None if d['Type'] == 'SecureString' else d.get(k, '').replace('$', '$$')
        ),
        'Type': partial(get_if_not_equal, value='String'),
        'KeyId': get,
        'AllowedPattern': get_if_not_empty,
        'Tier': partial(get_if_not_equal, value='Standard'),
        'Policies': lambda k, d: d.get(k) or None,  # This one is a list - often empty
        'DataType': partial(get_if_not_equal, value='text'),
    }

    # Only need the bare minimum in the companion file.
    dump_secure_fields = {
        'Name': get,
        'Value': lambda k, d: d.get(k, '').replace('$', '$$'),
    }

    # ---------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments to the command handler."""

        self.argp.add_argument(
            '-o',
            '--output',
            metavar='FILE.yaml',
            action='store',
            required=True,
            help=(
                'The name of an output YAML file for the parameters. SecureString'
                ' parameters will not have a value in this file. A companion YAML'
                ' file will contain the SecureString parameter values. If the output'
                ' file is named "params.yaml", the companion file will be named'
                ' "params.secure.yaml". Your .gitignore should contain "*.secure.yaml".'
                ' If the ouptut file name does not end with ".yaml", this will be added.'
            ),
        )

        self.argp.add_argument(
            '-r',
            '--recursive',
            action='store_true',
            help=(
                'Recurse into the parameter hierarchy. If not specified, only'
                ' parameters at the level of the specified path will be returned.'
            ),
        )

        self.argp.add_argument(
            'path',
            nargs='*',
            default=['/'],
            help='The hierarchy for the parameter(s). Must start with "/". Default is "/".',
        )

    # ---------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace) -> None:
        """Validate arguments."""

        for p in args.path:
            if not p.startswith('/'):
                raise ValueError(f'{p}: Path must start with "/"')

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """Dump SSM parameters."""

        # Can't use safe_dump here because we want to override the dumper.
        dumper = partial(yaml.dump, default_flow_style=False, Dumper=YamlIndentDumper)

        ssm = boto3.Session().client('ssm')

        # ------------------------------
        # We need the value of each parameter and the KMS key ID for SecureString
        # parameters so we need to merge the results from DescribeParameters and
        # GetParametersByPath.
        parameters = {}
        descriptions = {}
        for p in args.path:
            paginator = ssm.get_paginator('get_parameters_by_path')

            parameters |= {
                param['Name']: param
                for page in paginator.paginate(
                    Path=p, Recursive=args.recursive, WithDecryption=True
                )
                for param in page['Parameters']
            }

            descriptions |= ssm_describe_parameters_by_path(
                p, recursive=args.recursive, ssm_client=ssm
            )

        # Merge descriptions into the values.
        for k, v in parameters.items():
            try:
                v |= descriptions[k]
            except KeyError:
                raise Exception(f'Parameter {k} has a value but no description')

        # ------------------------------
        # Transform parameters into desired content and output
        # noinspection PyUnboundLocalVariable
        xform_params = [
            (v := transform_dict(param, self.dump_fields))
            for param in sorted(parameters.values(), key=lambda d: d['Name'])
            if v is not None
        ]
        if not args.output.endswith('.yaml'):
            args.output += '.yaml'
        with open(args.output, 'w') as fp:
            dumper({'Parameters': xform_params}, fp, sort_keys=False)
        n = len(xform_params)
        print(f'{n} {plural("parameter", n)} written to {args.output}')

        # ------------------------------
        # Find SecureStrings for the companion file.
        # noinspection PyUnboundLocalVariable
        secure_params = [
            (v := transform_dict(param, self.dump_secure_fields))
            for param in sorted(parameters.values(), key=lambda d: d['Name'])
            if param['Type'] == 'SecureString' and v is not None
        ]
        if secure_params:
            secure_path = Path(args.output).with_suffix('.secure.yaml')
            with open(secure_path, 'w') as fp:
                dumper({'SecureParameters': secure_params}, fp, sort_keys=False)
            n = len(secure_params)
            print(f'{n} secure parameter {plural("value", n)} written to {secure_path}')

        return 0


