@CliCommand.register('load')
class CmdLoad(CliCommand):
    """Load SSM parameters from a YAML file in the format produced by the "dump" command."""

    # List of SSM parameter attributes that are rendered with dotenv data
    render_attrs = ('Name', 'Value', 'Description', 'KeyId')

    # ---------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments for load."""

        self.argp.add_argument(
            '-e',
            '--env-file',
            metavar='FILE.env',
            action='store',
            help=(
                'The name of a dotenv formatted file containing variables to be'
                ' substituted into the values using $VAR / ${VAR} substitution.'
                ' If not specified, the file ".env" will be searched for, starting'
                ' with the current directory and working up to the root directory.'
                ' Environment variables are also used in the substitution process'
                ' and take precedence.'
            ),
        )

        self.argp.add_argument(
            '-f',
            '--force',
            action='store_true',
            help='Update existing SSM parameters. By default, existing parameters are skipped.',
        )

        self.argp.add_argument(
            '-i',
            '--input',
            metavar='FILE.yaml',
            action='store',
            help=(
                'The name of an input YAML file for the parameters. SecureString'
                ' parameters must not have a value in this file. A companion YAML'
                ' file should contain the SecureString parameter values. If the input'
                ' file is named "params.yaml", the companion file will be named'
                ' "params.secure.yaml". Your .gitignore should contain "*.secure.yaml".'
                ' If the input file name does not end with ".yaml", this will be added.'
            ),
        )

        self.argp.add_argument(
            '-p',
            '--path',
            action='store',
            help=(
                'Load the parameters under the specified path, which must start'
                ' with "/". If not specified, the parameter names in the input'
                ' file are used as is.'
            ),
        )

    # ------------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace):
        """Check the arguments."""

        if args.path:
            if not args.path.startswith('/'):
                raise ValueError('path must start with "/"')
            # Make args.path safe for '{args.path}/name' appends
            args.path = args.path.strip('/')
            if args.path:
                args.path = f'/{args.path}'

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """Load SSM parameters."""

        if not args.input.endswith('.yaml'):
            args.input += '.yaml'
        input_path = Path(args.input)
        params = self.read_param_file(input_path)

        have_secure_params = any(p.get('Type') == 'SecureString' for p in params.values())
        if have_secure_params:
            secure_path = Path(args.input).with_suffix('.secure.yaml')
            if not secure_path.exists():
                raise Exception(f'SecureString companion file {secure_path} does not exist')
            secure_params = self.read_secure_params_file(secure_path)
        else:
            secure_params = {}

        if not args.env_file:
            args.env_file = find_dotenv(usecwd=True)
        env_vars = {**dotenv_values(args.env_file), **environ}

        n_loaded = 0
        n_errors = 0
        n_skipped = 0
        ssm = boto3.Session().client('ssm')
        for name, param in params.items():
            if param.get('Type') == 'SecureString':
                try:
                    param['Value'] = secure_params[name]['Value']
                except KeyError:
                    print(f'{H1}{name}{RESET}: Cannot find value for SecureString parameter')
                    n_errors += 1
                    continue

            # Render any embedded parameters in the value
            subst_errors = True
            for attr in self.render_attrs:
                if not param.get(attr):
                    continue
                try:
                    param[attr] = Template(param[attr]).substitute(env_vars)
                except KeyError as e:
                    print(f'{H1}{name}{RESET}: {attr}: Cannot find value for {e} to substitute')
                    n_errors += 1
                    break
            else:
                subst_errors = False
            if subst_errors:
                continue

            if args.path is not None:
                param['Name'] = f'{args.path}/{param["Name"].strip("/")}'

            # Substitution / path addition could have changed the name.
            name = param['Name']

            if args.force or not ssm_param_exists(name, ssm_client=ssm):
                try:
                    ssm.put_parameter(**param, Overwrite=True)
                    print(f'{H1}{name}{RESET}: Loaded')
                    n_loaded += 1
                except (ParamValidationError, ClientError) as e:
                    print(f'{H1}{name}{RESET}: Failed - {e}')
                    n_errors += 1
            else:
                print(f'{H1}{name}{RESET}: Already exists')
                n_skipped += 1

        print()
        print(f'{n_loaded} SSM {plural("parameter", n_loaded)} loaded')
        print(f'{n_skipped} SSM {plural("parameter", n_skipped)} skipped')
        print(f'{n_errors} SSM {plural("error", n_errors)}')
        return 1 if n_errors else 0

    # ---------------------------------------------------------------------------
    @staticmethod
    def read_param_file(params_file: Path) -> dict[str, dict[str, Any]]:
        """Read the SSM parameters file."""
        with open(params_file) as fp:
            param_list = yaml.safe_load(fp).get('Parameters', [])

        # Do some validation and check if we have any SecureString params?
        params = {}
        for param in param_list:
            try:
                name = param['Name']
            except KeyError:
                raise Exception(f'{params_file}: "Name" key is required for all parameters')

            params[name] = param
            if param.get('Type') == 'SecureString' and 'Value' in param:
                raise Exception(
                    f'{params_file}: SecureString parameter {name} must not contain "Value"'
                )
        return params

    # ---------------------------------------------------------------------------
    @staticmethod
    def read_secure_params_file(secure_params_file: Path) -> dict[str, dict[str, Any]]:
        """Read the SSM secure parameters file."""
        with open(secure_params_file) as fp:
            secure_params_list = yaml.safe_load(fp)['SecureParameters']

        secure_params = {}
        for param in secure_params_list:
            try:
                name = param['Name']
            except KeyError:
                raise Exception(f'{secure_params_file}: "Name" key is required for all parameters')
            if 'Value' not in param:
                raise Exception(f'{secure_params_file}: "Value" key is required for all parameters')
            secure_params[name] = param
        return secure_params


