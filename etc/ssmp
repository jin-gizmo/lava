PROG = Path(sys.argv[0]).stem
ENV_PREFIX = 'SSMP_'  # Prefix for variable names generated by dump.
ENV_ALLOWED_PATTERNS = {f'{ENV_PREFIX}*'}  # Blessed environment vars for load.
ENV_VAR_KEY = '_EnvVar'

# A SecureString Value must be exactly one variable reference ($VAR or ${VAR}), so
# no part of a secret can be committed to the (repo-safe) parameters file. The
# identifier pattern matches string.Template's (ASCII only). Note that fullmatch()
# rejects a trailing newline, and an escaped "$$VAR" fails the match.
SECURE_REF = re.compile(r'\$(?:[A-Za-z_][A-Za-z0-9_]*|\{[A-Za-z_][A-Za-z0-9_]*})')

# Initialise colorama
init()

# Highlight styles
H1 = Fore.MAGENTA + Style.BRIGHT
H2 = Fore.WHITE
ERR = Fore.RED + Style.BRIGHT
WARNING = Fore.RED
INFO = Fore.BLUE + Style.BRIGHT
RESET = Style.RESET_ALL
OK = Fore.GREEN + Style.BRIGHT


# ------------------------------------------------------------------------------
def get(k: str, d: dict[str, Any]) -> Any:
    """Return the value of a given key from a dictionary."""
    return d[k]


# ------------------------------------------------------------------------------
def get_if_not_equal(k: str, d: dict[str, Any], value: Any) -> Any:
    """Return the value of a given key from a dictionary unless it matches the given value."""
    return d[k] if d[k] != value else None


# ------------------------------------------------------------------------------
def get_if_not_empty(k: str, d: dict[str, Any]) -> Any:
    """Return the value of a given key from a dictionary or None if its empty."""
    return d[k] or None


# ------------------------------------------------------------------------------
def plural(s: str, n: int) -> str:
    """Pluralise a string."""
    if n == 1:
        return s
    return f'{s}s'


# ------------------------------------------------------------------------------
def ask_yn(prompt: str, default: bool = False) -> bool:
    """Ask a yes/no question and return True for yes and False for no."""

    answer = input(prompt).strip().lower()
    if not answer:
        return default
    return answer.startswith('y')


# ------------------------------------------------------------------------------
def chunk_list(ll: list, max_len: int) -> Iterator[list]:
    """Split a list into chunks with a maximum specified length."""

    for i in range(0, len(ll), max_len):
        yield ll[i : i + max_len]


# ------------------------------------------------------------------------------
def transform_dict(d: dict[str, Any], transform: dict[str, Callable | None]) -> dict[str, Any]:
    """
    Transform a dictionary by applying a transform dict to drop or mutate values.

    :param d:           The dictionary to be transformed.
    :param transform:   A dict mapping keys to transformation functions. A missing
                        key or a None transformation function means discard the entry.
                        The transformation function must

    """

    result = {}
    for k, fn in transform.items():
        # Iterate over the transform dict to preserve ordering on output
        if k in d and fn and (v := fn(k, d)) is not None:
            result[k] = v
    return result


# ------------------------------------------------------------------------------
def ssm_param_exists(name: str, ssm_client=None) -> bool:
    """Check if an SSM parameter exists."""

    if not ssm_client:
        ssm_client = boto3.client('ssm')
    try:
        _ = ssm_client.get_parameter(Name=name)
        return True
    except ssm_client.exceptions.ParameterNotFound:
        return False


# ------------------------------------------------------------------------------
def ssm_describe_parameters_by_path(
    path: str, recursive: bool = False, ssm_client=None
) -> dict[str, Any]:
    """
    Describe SSM parameters by path.

    :param path:        Path to the SSM parameter. Must start with "/".
    :param recursive:   Recurse into the parameter hierarchy.
    :param ssm_client:  A boto3 SSM client.

    :return:    A dictionary mapping SSM parameter names to a dict containing
                parameter information.
    """

    if not path.startswith('/'):
        raise ValueError('Path must start with "/"')

    if not ssm_client:
        ssm_client = boto3.client('ssm')

    paginator = ssm_client.get_paginator('describe_parameters')
    return {
        param['Name']: param
        for page in paginator.paginate(
            ParameterFilters=[
                {
                    'Key': 'Path',
                    'Option': 'Recursive' if recursive else 'OneLevel',
                    'Values': [path],
                },
            ]
        )
        for param in page['Parameters']
    }


# ------------------------------------------------------------------------------
def ssm_describe_parameters_by_name(names: list[str], ssm_client=None) -> dict[str, Any]:
    """
    Describe SSM parameters by name.

    :param names:       A list of SSM parameter names.
    :param ssm_client:  A boto3 SSM client.

    :return:    A dictionary mapping SSM parameter names to a dict containing
                parameter information. If the parameter is not found, the value
                will be None.
    """

    if not ssm_client:
        ssm_client = boto3.client('ssm')

    params = dict.fromkeys(names, None)
    paginator = ssm_client.get_paginator('describe_parameters')
    for page in paginator.paginate(ParameterFilters=[{'Key': 'Name', 'Values': names}]):
        for param in page['Parameters']:
            params[param['Name']] = param
    return params


# ------------------------------------------------------------------------------
def ssm_policies_to_put_format(k: str, d: dict[str, Any]) -> str | None:
    """Convert DescribeParameters "Policies" to the JSON array string PutParameter expects."""

    policies = d.get(k, [])
    if not policies:
        return None
    return json.dumps([json.loads(p['PolicyText']) for p in policies])


# ------------------------------------------------------------------------------
def ssm_tags_to_put_format(k: str, d: dict[str, Any]) -> list[dict[str, str]] | None:
    """
    Return tags in the form `load` accepts, omitting AWS-managed ones.

    Tags are rendered by `load`, so "$" is escaped.
    """

    tags = [t for t in d.get(k, []) if not t['Key'].startswith('aws:')]
    if not tags:
        return None

    # Hack to apply escaping in a complex nested structure.
    return json.loads(json.dumps(tags).replace('$', '$$'))


# ------------------------------------------------------------------------------
def assign_env_vars(names: Iterable[str]) -> dict[str, str]:
    """Map SSM parameter names to unique environment variable names."""

    result: dict[str, str] = {}
    used: set[str] = set()
    for name in sorted(names):
        base = ENV_PREFIX + re.sub(r'[^A-Za-z0-9]', '_', name).strip('_').upper()
        var, n = base, 1
        while var in used:
            n += 1
            var = f'{base}_{n}'
        used.add(var)
        result[name] = var
    return result


# ------------------------------------------------------------------------------
class YamlIndentDumper(Dumper):
    """Correct indentation for yaml.dump."""

    def increase_indent(self, flow=False, indentless=False):
        """Correct indentation for yaml.dump."""
        return super().increase_indent(flow, False)


# ------------------------------------------------------------------------------
class CliCommand(ABC):
    """ClI command handler."""

    commands: ClassVar[dict[str, type[CliCommand]]] = {}
    name = None  # Set by @register decorator for subclasses.
    help_ = None  # Set by @register from first line of docstring.
    epilog_ = None  # Set by @register from rest of docstring.

    # --------------------------------------------------------------------------
    @classmethod
    def register(cls, name: str) -> Callable:
        """Register a CLI command handler class."""

        def decorate(cmd: type[CliCommand]):
            """Register the command handler class."""
            if not cmd.help_:
                raise Exception(f'Class {cmd.__name__} must define help_')
            cmd.name = name
            cls.commands[name] = cmd
            return cmd

        return decorate

    # --------------------------------------------------------------------------
    def __init__(self, subparser):
        """Initialize the command handler."""

        self.argp = subparser.add_parser(
            self.name, help=self.help_, description=self.help_, epilog=self.epilog_
        )
        self.argp.set_defaults(handler=self)

    # --------------------------------------------------------------------------
    def add_arguments(self):  # noqa B027
        """Add arguments to the command handler."""
        pass

    # --------------------------------------------------------------------------
    @staticmethod  # noqa B027
    def check_arguments(args: Namespace):
        """
        Validate arguments.

        :param args:        The namespace containing the arguments.
        :raise ValueError:  If the arguments are invalid.
        """

        pass

    # --------------------------------------------------------------------------
    @abstractmethod
    def execute(self, args: Namespace) -> int:
        """Execute the CLI command with the specified arguments."""
        raise NotImplementedError('execute')


# ------------------------------------------------------------------------------
@CliCommand.register('ls')
class CmdList(CliCommand):
    """List SSM parameters."""

    help_ = 'List SSM parameters.'

    # Transformation spec for long long list
    long_long_list_fields = {
        'ARN': get,
        'Type': get,
        'KeyId': get,
        'LastModifiedDate': get,
        'LastModifiedUser': get,
    }

    # ---------------------------------------------------------------------------
    def add_arguments(self):
        """Add arguments to the command handler."""

        self.argp.add_argument(
            '-l',
            dest='long',
            action='count',
            default=0,
            help='List parameters in long format. Can be repeated to get more information.',
        )

        self.argp.add_argument(
            '-r',
            '--recursive',
            action='store_true',
            help=(
                'Recurse into the parameter hierarchy. If not specified, only'
                ' parameters at the level of the specified path will be returned.'
            ),
        )

        self.argp.add_argument(
            'path',
            nargs='*',
            default=['/'],
            help='The hierarchy for the parameter(s). Must start with "/". Default is "/".',
        )

    # ---------------------------------------------------------------------------
    @staticmethod
    def check_arguments(args: Namespace):
        """Validate arguments."""

        for p in args.path:
            if not p.startswith('/'):
                raise ValueError(f'{p}: Path must start with "/"')

    # ---------------------------------------------------------------------------
    def execute(self, args: Namespace) -> int:
        """List SSM parameters."""

        ssm = boto3.Session().client('ssm')
        parameters = {}
        for p in args.path:
            parameters |= ssm_describe_parameters_by_path(
                p, recursive=args.recursive, ssm_client=ssm
            )
        for name in sorted(parameters):
            if not args.long:
                print(name)
                continue

            print(f'{H1}{name}{RESET}: {parameters[name].get("Description", "")}')
            if args.long > 1:
                p = transform_dict(parameters[name], self.long_long_list_fields)
                for k, v in p.items():
                    print(f'    {H2}{k}{RESET}: {v}')
        return 0


