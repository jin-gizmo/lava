#!/usr/bin/env python3

"""Merge a directory tree of Markdown files."""

from __future__ import annotations

import argparse
import itertools
import re
import sys
from collections.abc import Iterator
from pathlib import Path
from typing import TextIO

PROG = Path(sys.argv[0]).stem

FOOTNOTE_DEFINITION_RE = re.compile(r'^\s*\[\^([^]]+)]:')
FOOTNOTE_REFERENCE_RE = re.compile(r'\[\^([^]]+)]')

footnote_numbers = itertools.count(1)


# ------------------------------------------------------------------------------
def get_fence(line: str) -> str | None:
    """Return the leading whitespace and backticks of a code fence, or None."""
    stripped = line.lstrip()
    if not stripped.startswith('```'):
        return None
    return line[: len(line) - len(stripped.lstrip('`'))]


# ------------------------------------------------------------------------------
def is_fence_end(line: str, fence: str) -> bool:
    """Return whether a line closes a fenced code block."""
    return line.startswith(fence) and set(line[len(fence) :]) in (set(), {'`'})


# ------------------------------------------------------------------------------
def fix_footnotes(lines: list[str], numbers: Iterator[int]) -> list[str]:
    """Renumber footnotes in one markdown chunk (file)."""

    labels: dict[str, int] = {}

    # First pass -- build a map of footnote definitions: source tag --> new tag
    fence = None
    for line_number, line in enumerate(lines, 1):
        if fence:
            if is_fence_end(line, fence):
                fence = None
            continue

        if fence := get_fence(line):
            continue

        if not (match := FOOTNOTE_DEFINITION_RE.match(line)):
            continue

        # Found a footnote definition. Get its new number so we can adjust usages later.
        label = match.group(1)
        if label in labels:
            raise RuntimeError(f'{line_number}: duplicate footnote definition: {label!r}')
        labels[label] = next(numbers)

    # Second pass -- rewrite the references to definitions with new tag values.
    # Footnote definition tags look enough like references that they will get
    # fixed naturally as part of this process.
    fence = None
    for line_number, line in enumerate(lines, 1):
        if fence:
            if is_fence_end(line, fence):
                fence = None
            continue

        if fence := get_fence(line):
            continue

        # We use finditer() here not findall() because we want match objects not strings.
        if matches := list(FOOTNOTE_REFERENCE_RE.finditer(line)):
            rewritten: list[str] = []
            position = 0

            for match in matches:
                if (label := match.group(1)) not in labels:
                    raise RuntimeError(f'{line_number}: undefined footnote: {label!r}')

                rewritten.append(line[position : match.start(1)])
                rewritten.append(str(labels[label]))
                position = match.end(1)

            rewritten.append(line[position:])
            lines[line_number - 1] = ''.join(rewritten)

    return lines


# ------------------------------------------------------------------------------
def process_cli_args():
    """
    Process the command line arguments.

    :return:    The args namespace.
    """

    argp = argparse.ArgumentParser(prog=PROG, description=__doc__)

    argp.add_argument(
        '-d',
        '--dir',
        action='store',
        type=Path,
        default='.',
        help='Markdown document directory. Default is current directory.',
    )

    return argp.parse_args()


# ------------------------------------------------------------------------------
def find_markdown_files(root: Path) -> list[Path]:
    """Return Markdown files sorted by relative path."""
    return sorted(
        (path.relative_to(root) for path in root.rglob('*.md') if path.is_file()),
        key=lambda path: path.as_posix(),
    )


# ------------------------------------------------------------------------------
def process_file(path: Path, output: TextIO | None = None) -> None:
    """Process a single Markdown file."""

    if output is None:
        output = sys.stdout

    lines = path.read_text(encoding='utf-8').splitlines()
    lines = fix_footnotes(lines, footnote_numbers)
    # If the first line of the file is a header, it may get missed when it is
    # joined to another file so we insert a blank line before every file.
    print(file=output)
    for line in lines:
        print(line, file=output)


# ------------------------------------------------------------------------------
def main() -> int:
    """Merge a directory tree of Markdown files."""

    args = process_cli_args()

    if not args.dir.is_dir():
        raise NotADirectoryError(f'{args.dir} is not a directory')

    for f in find_markdown_files(args.dir):
        try:
            process_file(args.dir / f)
        except Exception as e:
            raise RuntimeError(f'{f}: {e}') from e

    return 0


# ------------------------------------------------------------------------------
if __name__ == '__main__':
    # Uncomment for debugging
    # exit(main())  # noqa: ERA001
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(f'{PROG}: Interrupt', file=sys.stderr)
        sys.exit(2)
    except Exception as ex:
        print(f'{PROG}: {ex}', file=sys.stderr)
        sys.exit(1)
