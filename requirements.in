# These are the requirements for the main code bundle.
# It excludes things needed to build lava but not needed to run it.

# ex: set ft=sh:

# chardet 6+ currently causes a spurious warning from requests.
chardet<6
boto3
botocore
cachetools
colorama
cookiecutter
oracledb
docker
jinja2
jsonschema

# This is needed because redshift-connector 2.2.0 requires scramp<1.5.0,>=1.2.0
# and pg8000 1.31.6 requires scramp==1.5.0 so we have a conflict. Pg8000 v1.31.6
# only upgrades its scramp to v1.5.0. Scramp v1.5.0 includes breaking changes
# and does not appear to fix any CVEs so safer to hold pg8000 back for now.
# -- Murray (30/10/2026)
pg8000<1.31.6

psutil
pygments
pymysql
pysmb
python-dateutil
pyyaml
requests
smbprotocol
sqlalchemy
sqlparse
graphlib-backport>=1.0.3; python_version < '3.9'
tabulate
smart_open[s3]
packaging
